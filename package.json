{
  "name": "shoplk",
  "private": true,
  "version": "1.0.0",
  "description": "ShopLK ecommerce workspace",
  "scripts": {
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:admin": "npm run dev --prefix admin-pos",
    "start:backend": "npm start --prefix backend",
    "build": "npm run build:frontend && npm run build:admin",
    "build:frontend": "npm run build --prefix frontend",
    "build:admin": "npm run build --prefix admin-pos",
    "lint:admin": "npm run lint --prefix admin-pos",
    "install:all": "npm install --prefix backend && npm install --prefix frontend && npm install --prefix admin-pos"
  },
  "engines": {
    "node": ">=18"
  }
}
